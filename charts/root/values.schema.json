{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Con Services cluster.yaml",
  "description": "Settings of one Con Services installation. Unknown keys are rejected so that typos fail early.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "quantity": {"type": ["string", "number"]},
    "nonEmpty": {"type": "string", "minLength": 1},
    "values": {"type": "object", "description": "Extra chart values, merged last."},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/cpuMemory"},
        "limits": {"$ref": "#/definitions/cpuMemory"}
      }
    },
    "cpuMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"$ref": "#/definitions/quantity"},
        "memory": {"$ref": "#/definitions/quantity"}
      }
    },
    "replicas": {"type": "integer", "minimum": 1},
    "k8sName": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"},
    "replicasOrProfile": {"type": ["integer", "null"], "minimum": 1, "description": "Empty: the value of the profile."},
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+-\\d+$",
      "description": "Release of the app: image tag MAJOR.MINOR.PATCH-BUILD, never latest."
    },
    "chartRevision": {
      "type": "string",
      "pattern": "^\\S*$",
      "description": "Git revision of charts.repoURL with the app's chart. Empty: the tag <app>/v<MAJOR.MINOR.PATCH>."
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "One lowercase DNS label (no dots): the app lives on <host>.<domain>, covered by the wildcard certificate."
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "version": {"$ref": "#/definitions/version"},
        "chartRevision": {"$ref": "#/definitions/chartRevision"},
        "host": {"$ref": "#/definitions/host"},
        "accessConfig": {"type": "string"},
        "values": {"$ref": "#/definitions/values"}
      }
    },
    "gatewaySide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loadBalancerIP": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  },
  "required": ["domain", "git", "acme", "s3", "den"],
  "properties": {
    "global": {"type": "object"},
    "domain": {"type": "string", "pattern": "^(change-me|([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,})$"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoURL"],
      "properties": {
        "repoURL": {"$ref": "#/definitions/nonEmpty"},
        "targetRevision": {"$ref": "#/definitions/nonEmpty"}
      }
    },
    "acme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": {
        "email": {"$ref": "#/definitions/nonEmpty"},
        "issuer": {"enum": ["letsencrypt-staging", "letsencrypt-prod"]},
        "dns01": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {"enum": ["cloudflare", "custom"]},
            "solvers": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "region", "bucketPrefix", "fqdns"],
      "properties": {
        "endpoint": {"$ref": "#/definitions/nonEmpty"},
        "region": {"$ref": "#/definitions/nonEmpty"},
        "pathStyle": {"type": "boolean"},
        "bucketPrefix": {"type": "string", "pattern": "^(change-me|[a-z0-9][a-z0-9-]{0,30}[a-z0-9])$"},
        "fqdns": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/nonEmpty"}},
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {"type": "string"},
            "region": {"type": "string"},
            "pathStyle": {"type": ["boolean", "null"]},
            "fqdns": {"type": "array", "items": {"$ref": "#/definitions/nonEmpty"}}
          }
        }
      }
    },
    "den": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backupAgeRecipients"],
      "properties": {
        "backupAgeRecipients": {"$ref": "#/definitions/nonEmpty"},
        "version": {"$ref": "#/definitions/version"},
        "chartRevision": {"$ref": "#/definitions/chartRevision"},
        "host": {"$ref": "#/definitions/host"},
        "values": {"$ref": "#/definitions/values"}
      }
    },
    "rootApplication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/definitions/k8sName"}
      }
    },
    "profile": {"enum": ["standard", "small"]},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pullSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    },
    "charts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repoURL": {"$ref": "#/definitions/nonEmpty"}
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stash": {"$ref": "#/definitions/module"},
        "hr": {"$ref": "#/definitions/module"},
        "rally": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "version": {"$ref": "#/definitions/version"},
            "chartRevision": {"$ref": "#/definitions/chartRevision"},
            "host": {"$ref": "#/definitions/host"},
            "accessConfig": {"type": "string"},
            "submit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "host": {"$ref": "#/definitions/host"}
              }
            },
            "values": {"$ref": "#/definitions/values"}
          }
        },
        "finance": {"$ref": "#/definitions/module"},
        "learn": {"$ref": "#/definitions/module"},
        "wiki": {"$ref": "#/definitions/module"},
        "desk": {"$ref": "#/definitions/module"},
        "tasks": {"$ref": "#/definitions/module"}
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"from": {"type": "string"}}
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {"$ref": "#/definitions/nonEmpty"},
        "public": {"$ref": "#/definitions/gatewaySide"},
        "internal": {"$ref": "#/definitions/gatewaySide"}
      }
    },
    "adminRoutes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "longhorn": {"type": "boolean"},
        "hubble": {"type": "boolean"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {"type": "string"},
        "longhornSingle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the cluster's External Secrets Operator runs (a prerequisite).",
      "properties": {
        "namespace": {"$ref": "#/definitions/k8sName"},
        "serviceAccount": {"$ref": "#/definitions/k8sName"}
      }
    },
    "openbao": {
      "type": "object",
      "additionalProperties": false,
      "description": "How External Secrets Operator reaches the cluster's OpenBao (a prerequisite).",
      "properties": {
        "server": {"type": "string", "pattern": "^https://[^\\s/]+(:\\d+)?/?$"},
        "kvPath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
          "description": "Mount path of the KV version 2 engine that holds every Con Services entry (modules/..., infra/...). Default conservices."
        },
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"enum": ["ConfigMap", "Secret"]},
            "name": {"type": "string"},
            "key": {"$ref": "#/definitions/nonEmpty"},
            "namespace": {"type": "string"}
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mountPath": {"$ref": "#/definitions/nonEmpty"},
            "role": {"$ref": "#/definitions/nonEmpty"}
          }
        },
        "namespace": {"type": "string"},
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "role": {"$ref": "#/definitions/nonEmpty"},
            "serviceAccount": {"$ref": "#/definitions/k8sName"},
            "image": {"type": "string", "pattern": "^[^\\s:]+(:[^\\s:]+)?(@sha256:[a-f0-9]{64})?$"}
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instances": {"$ref": "#/definitions/replicasOrProfile"},
        "resources": {"$ref": "#/definitions/resources"},
        "operatorNamespace": {"$ref": "#/definitions/k8sName"},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": {"type": "string"},
            "size": {"$ref": "#/definitions/quantity"},
            "walSize": {"$ref": "#/definitions/quantity"}
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schedule": {"type": "string"},
            "retention": {"type": "string", "pattern": "^\\d+[dwm]$"},
            "sidecarResources": {"$ref": "#/definitions/resources"}
          }
        }
      }
    },
    "keycloakOperator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"resources": {"$ref": "#/definitions/resources"}}
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {"$ref": "#/definitions/host"},
        "adminHost": {"$ref": "#/definitions/host"},
        "instances": {"$ref": "#/definitions/replicasOrProfile"},
        "resources": {"$ref": "#/definitions/resources"},
        "smtp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    }
  }
}
