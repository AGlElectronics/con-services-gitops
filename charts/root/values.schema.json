{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Con Services cluster.yaml",
  "description": "Settings of one Con Services installation. Unknown keys are rejected so that typos fail early.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "quantity": {"type": ["string", "number"]},
    "nonEmpty": {"type": "string", "minLength": 1},
    "values": {"type": "object", "description": "Extra chart values, merged last."},
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/cpuMemory"},
        "limits": {"$ref": "#/definitions/cpuMemory"}
      }
    },
    "cpuMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"$ref": "#/definitions/quantity"},
        "memory": {"$ref": "#/definitions/quantity"}
      }
    },
    "replicas": {"type": "integer", "minimum": 1},
    "imageTag": {"type": "string", "not": {"const": "latest"}},
    "image": {"type": "string", "pattern": "^[^\\s]+:[^\\s:/]+$", "not": {"pattern": ":latest$"}},
    "module": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "imageTag": {"$ref": "#/definitions/imageTag"},
        "accessConfig": {"type": "string"},
        "values": {"$ref": "#/definitions/values"}
      }
    },
    "gatewaySide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loadBalancerIP": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  },
  "required": ["domain", "git", "acme", "s3", "den"],
  "properties": {
    "global": {"type": "object"},
    "domain": {"type": "string", "pattern": "^(change-me|([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,})$"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repoURL"],
      "properties": {
        "repoURL": {"$ref": "#/definitions/nonEmpty"},
        "targetRevision": {"$ref": "#/definitions/nonEmpty"}
      }
    },
    "acme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": {
        "email": {"$ref": "#/definitions/nonEmpty"},
        "issuer": {"enum": ["letsencrypt-staging", "letsencrypt-prod"]},
        "dns01": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {"enum": ["cloudflare", "custom"]},
            "solvers": {"type": "array", "items": {"type": "object"}}
          }
        },
        "recursiveNameservers": {"type": "string"}
      }
    },
    "s3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "region", "bucketPrefix", "fqdns"],
      "properties": {
        "endpoint": {"$ref": "#/definitions/nonEmpty"},
        "region": {"$ref": "#/definitions/nonEmpty"},
        "pathStyle": {"type": "boolean"},
        "bucketPrefix": {"type": "string", "pattern": "^(change-me|[a-z0-9][a-z0-9-]{0,30}[a-z0-9])$"},
        "fqdns": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/nonEmpty"}},
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {"type": "string"},
            "region": {"type": "string"},
            "pathStyle": {"type": ["boolean", "null"]},
            "fqdns": {"type": "array", "items": {"$ref": "#/definitions/nonEmpty"}}
          }
        }
      }
    },
    "den": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backupAgeRecipients"],
      "properties": {
        "backupAgeRecipients": {"$ref": "#/definitions/nonEmpty"},
        "imageTag": {"$ref": "#/definitions/imageTag"},
        "values": {"$ref": "#/definitions/values"}
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+-\\d+$"},
        "pullSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    },
    "charts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repoURL": {"$ref": "#/definitions/nonEmpty"},
        "targetRevision": {"$ref": "#/definitions/nonEmpty"}
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stash": {"$ref": "#/definitions/module"},
        "hr": {"$ref": "#/definitions/module"},
        "rally": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "imageTag": {"$ref": "#/definitions/imageTag"},
            "accessConfig": {"type": "string"},
            "submit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {"enabled": {"type": "boolean"}}
            },
            "values": {"$ref": "#/definitions/values"}
          }
        },
        "finance": {"$ref": "#/definitions/module"},
        "learn": {"$ref": "#/definitions/module"},
        "wiki": {"$ref": "#/definitions/module"},
        "desk": {"$ref": "#/definitions/module"},
        "tasks": {"$ref": "#/definitions/module"}
      }
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"from": {"type": "string"}}
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {"$ref": "#/definitions/nonEmpty"},
        "public": {"$ref": "#/definitions/gatewaySide"},
        "internal": {"$ref": "#/definitions/gatewaySide"}
      }
    },
    "loadBalancer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ciliumL2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "blocks": {
              "type": "array",
              "items": {
                "oneOf": [
                  {"type": "string"},
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["start", "stop"],
                    "properties": {"start": {"type": "string"}, "stop": {"type": "string"}}
                  }
                ]
              }
            },
            "interfaces": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "oidcHairpin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"mode": {"enum": ["none", "coredns-custom"]}}
    },
    "adminRoutes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openbao": {"type": "boolean"},
        "longhorn": {"type": "boolean"},
        "hubble": {"type": "boolean"}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "className": {"type": "string"},
        "longhornSingle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    },
    "certManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controller": {"$ref": "#/definitions/resources"},
            "webhook": {"$ref": "#/definitions/resources"},
            "cainjector": {"$ref": "#/definitions/resources"},
            "startupapicheck": {"$ref": "#/definitions/resources"}
          }
        },
        "values": {"$ref": "#/definitions/values"}
      }
    },
    "trustManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controller": {"$ref": "#/definitions/resources"},
            "defaultPackage": {"$ref": "#/definitions/resources"}
          }
        },
        "values": {"$ref": "#/definitions/values"}
      }
    },
    "externalSecrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"$ref": "#/definitions/replicas"},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controller": {"$ref": "#/definitions/resources"},
            "webhook": {"$ref": "#/definitions/resources"},
            "certController": {"$ref": "#/definitions/resources"}
          }
        },
        "values": {"$ref": "#/definitions/values"}
      }
    },
    "openbao": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "enum": [1, 3, 5]},
        "resources": {"$ref": "#/definitions/resources"},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": {"type": "string"},
            "dataSize": {"$ref": "#/definitions/quantity"},
            "auditSize": {"$ref": "#/definitions/quantity"}
          }
        },
        "values": {"$ref": "#/definitions/values"}
      }
    },
    "cnpg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replicas": {"$ref": "#/definitions/replicas"},
            "resources": {"$ref": "#/definitions/resources"},
            "values": {"$ref": "#/definitions/values"}
          }
        },
        "barmanCloud": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replicas": {"$ref": "#/definitions/replicas"},
            "resources": {"$ref": "#/definitions/resources"},
            "sidecarResources": {"$ref": "#/definitions/resources"},
            "values": {"$ref": "#/definitions/values"}
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instances": {"$ref": "#/definitions/replicas"},
        "resources": {"$ref": "#/definitions/resources"},
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": {"type": "string"},
            "size": {"$ref": "#/definitions/quantity"},
            "walSize": {"$ref": "#/definitions/quantity"}
          }
        },
        "backup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schedule": {"type": "string"},
            "retention": {"type": "string", "pattern": "^\\d+[dwm]$"}
          }
        }
      }
    },
    "keycloakOperator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"resources": {"$ref": "#/definitions/resources"}}
    },
    "keycloak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instances": {"$ref": "#/definitions/replicas"},
        "resources": {"$ref": "#/definitions/resources"},
        "smtp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}}
        }
      }
    },
    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selfManage": {"type": "boolean"},
        "values": {"$ref": "#/definitions/values"}
      }
    },
    "arc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "githubConfigUrl": {"type": "string", "pattern": "^https://"},
        "runnerScaleSetName": {"$ref": "#/definitions/nonEmpty"},
        "minRunners": {"type": "integer", "minimum": 0},
        "maxRunners": {"type": "integer", "minimum": 1},
        "runnerImage": {"$ref": "#/definitions/image"},
        "buildkitImage": {"$ref": "#/definitions/image"},
        "testDatabaseImage": {"$ref": "#/definitions/image"},
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controller": {"$ref": "#/definitions/resources"},
            "listener": {"$ref": "#/definitions/resources"},
            "runner": {"$ref": "#/definitions/resources"},
            "buildkit": {"$ref": "#/definitions/resources"},
            "testDatabase": {"$ref": "#/definitions/resources"}
          }
        }
      }
    }
  }
}
